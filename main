# ===== АДМИН ДЕЙСТВИЯ =====
def handle_admin_actions(call):
    user_id = call.from_user.id
    data = call.data

    if data == "admin_stats":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM users");
        users_count = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM orders WHERE status='new' OR status='pending'");
        new_orders = c.fetchone()[0]
        c.execute("SELECT SUM(amount) FROM orders WHERE status='completed'");
        total_income = c.fetchone()[0] or 0
        c.execute("SELECT COUNT(*) FROM orders WHERE status='completed' AND date(completed_at)=date('now')");
        today = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM deposit_requests WHERE status='pending'");
        deps = c.fetchone()[0]
        conn.close()
        platega = "✅" if is_platega_enabled() else "❌"
        text = (f"📊 <b>Статистика</b>\n\n👥 {users_count}\n📦 Новых: {new_orders}\n"
                f"✅ Сегодня: {today}\n💰 Доход: {total_income}₽\n🧾 Заявок: {deps}\n💳 Platega: {platega}")
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_orders":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("""SELECT order_num, user_id, product_name, amount, status, created_at 
                     FROM orders ORDER BY id DESC LIMIT 20""")
        orders = c.fetchall()
        conn.close()
        text = "📋 <b>Заказы</b>\n\n" if orders else "📋 Нет заказов"
        for o in orders:
            emoji = "✅" if o[4] == "completed" else "🟡" if o[4] == "new" else "🟠" if o[4] == "pending" else "❌"
            text += f"{emoji} <code>{o[0]}</code> | {o[2]} | {o[3]}₽\n"
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("📋 Все", callback_data="admin_all_orders"),
            InlineKeyboardButton("🆕 Новые", callback_data="admin_new_orders"),
            InlineKeyboardButton("🔍 Поиск", callback_data="admin_search_order"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_all_orders":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("""SELECT order_num, product_name, amount, status FROM orders 
                     ORDER BY id DESC LIMIT 50""")
        orders = c.fetchall()
        conn.close()
        text = "📋 <b>Все заказы</b>\n\n"
        for o in orders:
            emoji = "✅" if o[3] == "completed" else "🟡" if o[3] == "new" else "🟠" if o[3] == "pending" else "❌"
            text += f"{emoji} <code>{o[0]}</code> | {o[1]} | {o[2]}₽\n"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_orders"))
        bot.edit_message_text(text or "Нет заказов", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data == "admin_new_orders":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("""SELECT order_num, product_name, amount FROM orders 
                     WHERE status='new' OR status='pending' ORDER BY id DESC""")
        orders = c.fetchall()
        conn.close()
        text = "🆕 <b>Новые</b>\n\n" if orders else "🆕 Нет новых"
        for o in orders:
            text += f"🟡 <code>{o[0]}</code> | {o[1]} | {o[2]}₽\n"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_orders"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_search_order":
        bot.edit_message_text("🔍 Введите номер заказа:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_search_order)

    elif data.startswith("admin_complete_order_"):
        order_num = data.split("_")[3]
        order = get_order_by_num(order_num)
        if order:
            update_order_status(order_num, 'completed', 'Выполнен админом')
            bot.answer_callback_query(call.id, "✅ Выполнен")
            try:
                bot.send_message(order[2], f"✅ Заказ {order_num} выполнен!")
            except:
                pass

    elif data.startswith("admin_cancel_order_"):
        order_num = data.split("_")[3]
        order = get_order_by_num(order_num)
        if order:
            if order[7] > 0 and order[5] in ['new', 'pending']:
                add_balance(order[2], order[7])
            update_order_status(order_num, 'cancelled', 'Отменён админом')
            bot.answer_callback_query(call.id, "❌ Отменён")
            try:
                bot.send_message(order[2], f"❌ Заказ {order_num} отменён. Деньги возвращены.")
            except:
                pass

    elif data.startswith("admin_add_data_"):
        order_num = data.split("_")[3]
        bot.edit_message_text(f"✏️ Введите данные для заказа {order_num}:",
                              user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, lambda msg: process_add_order_data(msg, order_num))

    elif data.startswith("admin_send_code_"):
        admin_send_code(call)

    # ===== ЗАЯВКИ =====
    elif data == "admin_deposits":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("""SELECT deposit_id, user_id, amount, created_at 
                     FROM deposit_requests WHERE status='pending' ORDER BY id DESC""")
        deps = c.fetchall()
        conn.close()
        text = "🧾 <b>Заявки на пополнение</b>\n\n" if deps else "🧾 Нет заявок"
        for d in deps:
            text += f"⏳ <code>{d[0]}</code> | {d[2]}₽ | {d[1]}\n"
        if deps:
            text += "\nОбрабатывайте из уведомлений"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data.startswith("admin_dep_ok_"):
        deposit_id = data.split("_")[3]
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT * FROM deposit_requests WHERE deposit_id=? AND status='pending'", (deposit_id,))
        dep = c.fetchone()
        if not dep:
            conn.close()
            bot.answer_callback_query(call.id, "❌ Не найдена")
            return
        add_balance(dep[2], dep[3])
        c.execute("""UPDATE deposit_requests SET status='approved', processed_at=?, admin_id=?
                     WHERE deposit_id=?""", (datetime.now().isoformat(), user_id, deposit_id))
        conn.commit()
        conn.close()
        try:
            bot.send_message(dep[2], f"✅ Пополнение {dep[3]}₽ подтверждено!\n💰 Баланс: {get_balance(dep[2])}₽",
                             reply_markup=main_menu(dep[2]))
        except:
            pass
        bot.edit_message_text(f"✅ +{dep[3]}₽ пользователю {dep[2]}", user_id, call.message.message_id,
                              parse_mode="HTML")
        bot.answer_callback_query(call.id, f"✅ +{dep[3]}₽")

    elif data.startswith("admin_dep_no_"):
        deposit_id = data.split("_")[3]
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT * FROM deposit_requests WHERE deposit_id=? AND status='pending'", (deposit_id,))
        dep = c.fetchone()
        if not dep:
            conn.close()
            bot.answer_callback_query(call.id, "❌ Не найдена")
            return
        c.execute("""UPDATE deposit_requests SET status='rejected', processed_at=?, admin_id=?
                     WHERE deposit_id=?""", (datetime.now().isoformat(), user_id, deposit_id))
        conn.commit()
        conn.close()
        try:
            bot.send_message(dep[2], f"❌ Заявка {deposit_id} отклонена")
        except:
            pass
        bot.edit_message_text(f"❌ Заявка {deposit_id} отклонена", user_id, call.message.message_id, parse_mode="HTML")
        bot.answer_callback_query(call.id, "❌")

    elif data.startswith("admin_user_info_"):
        target_id = int(data.split("_")[3])
        user = get_user(target_id)
        if not user:
            bot.answer_callback_query(call.id, "❌ Не найден")
            return
        balance = get_balance(target_id)
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM orders WHERE user_id=?", (target_id,))
        orders_count = c.fetchone()[0]
        conn.close()
        text = (f"👤 <b>Пользователь</b>\n\n🆔 <code>{user[0]}</code>\n📝 {user[2]}\n"
                f"👤 @{user[1] if user[1] != 'Нет' else 'Нет'}\n💰 {balance}₽\n📦 Заказов: {orders_count}")
        markup = InlineKeyboardMarkup(row_width=3)
        markup.add(
            InlineKeyboardButton("+100₽", callback_data=f"admin_quick_add_{target_id}_100"),
            InlineKeyboardButton("+500₽", callback_data=f"admin_quick_add_{target_id}_500"),
            InlineKeyboardButton("+1000₽", callback_data=f"admin_quick_add_{target_id}_1000")
        )
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin"))
        bot.send_message(user_id, text, parse_mode="HTML", reply_markup=markup)

    elif data.startswith("admin_quick_add_"):
        parts = data.split("_")
        target_id = int(parts[3])
        amount = float(parts[4])
        add_balance(target_id, amount)
        bot.answer_callback_query(call.id, f"✅ +{amount}₽")
        try:
            bot.send_message(target_id, f"💰 Начислено {amount}₽")
        except:
            pass

    # ===== ТОВАРЫ =====
    elif data == "admin_products":
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("➕ Добавить", callback_data="admin_add_product"),
            InlineKeyboardButton("🗑 Удалить", callback_data="admin_del_product"),
            InlineKeyboardButton("📋 Список", callback_data="admin_list_products"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text("📦 <b>Товары</b>", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data == "admin_list_products":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT id, name, price FROM products ORDER BY name")
        products = c.fetchall()
        conn.close()
        text = "📋 <b>Товары</b>\n\n" if products else "Нет товаров"
        for p in products:
            text += f"🆔 {p[0]} | {p[1]} | {p[2]}₽\n"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_products"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_del_product":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT id, name FROM products ORDER BY name")
        products = c.fetchall()
        conn.close()
        if not products:
            bot.answer_callback_query(call.id, "Нет товаров")
            return
        markup = InlineKeyboardMarkup(row_width=2)
        for p in products:
            markup.add(InlineKeyboardButton(f"❌ {p[1]}", callback_data=f"admin_del_product_confirm_{p[0]}"))
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_products"))
        bot.edit_message_text("🗑 Выберите:", user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data.startswith("admin_del_product_confirm_"):
        prod_id = int(data.split("_")[4])
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("DELETE FROM products WHERE id=?", (prod_id,))
        conn.commit()
        conn.close()
        bot.answer_callback_query(call.id, "✅ Удалён")
        edit_to_main_menu(user_id, call.message.message_id)

    elif data == "admin_add_product":
        bot.edit_message_text("➕ Введите название товара:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_add_product_name)

    # ===== КАТЕГОРИИ =====
    elif data == "admin_categories":
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("➕ Категория", callback_data="admin_add_cat"),
            InlineKeyboardButton("📂 Подкатегория", callback_data="admin_add_subcat"),
            InlineKeyboardButton("🗑 Удалить", callback_data="admin_del_cat"),
            InlineKeyboardButton("📋 Список", callback_data="admin_list_cats"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text("📂 <b>Категории</b>", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data == "admin_list_cats":
        categories = get_categories(0)
        text = "📋 <b>Категории</b>\n\n"
        for cat in categories:
            text += f"📁 {cat[1]} (ID: {cat[0]})\n"
            for sub in get_categories(cat[0]):
                text += f"  └─ 📂 {sub[1]} (ID: {sub[0]})\n"
        if not categories:
            text = "Нет категорий"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_categories"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_add_cat":
        bot.edit_message_text("➕ Введите название категории:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_add_category)

    elif data == "admin_add_subcat":
        categories = get_categories(0)
        if not categories:
            bot.answer_callback_query(call.id, "Сначала создайте категорию")
            return
        markup = InlineKeyboardMarkup(row_width=2)
        for cat in categories:
            markup.add(InlineKeyboardButton(cat[1], callback_data=f"admin_select_parent_{cat[0]}"))
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_categories"))
        bot.edit_message_text("📂 Выберите родителя:", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data.startswith("admin_select_parent_"):
        parent_id = int(data.split("_")[3])
        bot.edit_message_text("➕ Введите название подкатегории:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, lambda msg: process_add_subcategory(msg, parent_id))

    elif data == "admin_del_cat":
        categories = get_categories(0)
        markup = InlineKeyboardMarkup(row_width=2)
        for cat in categories:
            markup.add(InlineKeyboardButton(f"❌ {cat[1]}", callback_data=f"admin_del_cat_confirm_{cat[0]}"))
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_categories"))
        bot.edit_message_text("🗑 Выберите:", user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data.startswith("admin_del_cat_confirm_"):
        cat_id = int(data.split("_")[4])
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("DELETE FROM categories WHERE id=? OR parent_id=?", (cat_id, cat_id))
        conn.commit()
        conn.close()
        bot.answer_callback_query(call.id, "✅ Удалена")
        edit_to_main_menu(user_id, call.message.message_id)

    # ===== БАЛАНСЫ =====
    elif data == "admin_balances":
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("➕ Пополнить", callback_data="admin_add_balance"),
            InlineKeyboardButton("➖ Списать", callback_data="admin_sub_balance"),
            InlineKeyboardButton("🔍 Проверить", callback_data="admin_check_balance"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text("💰 <b>Балансы</b>", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data == "admin_check_balance":
        bot.edit_message_text("🔍 Введите ID пользователя:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_check_balance)

    elif data == "admin_add_balance":
        bot.edit_message_text("➕ Введите: ID сумма", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_admin_add_balance)

    elif data == "admin_sub_balance":
        bot.edit_message_text("➖ Введите: ID сумма", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_admin_sub_balance)

    # ===== ПРОМОКОДЫ =====
    elif data == "admin_promocodes":
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("➕ Создать", callback_data="admin_create_promo"),
            InlineKeyboardButton("🗑 Удалить", callback_data="admin_del_promo"),
            InlineKeyboardButton("📋 Список", callback_data="admin_list_promo"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text("🎫 <b>Промокоды</b>", user_id, call.message.message_id, reply_markup=markup,
                              parse_mode="HTML")

    elif data == "admin_create_promo":
        bot.edit_message_text(
            "🎫 Введите: <code>код|тип|значение</code>\n\nТипы: balance, discount_all, discount_category, discount_product",
            user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_create_promo)

    elif data == "admin_del_promo":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT id, code FROM promocodes")
        promos = c.fetchall()
        conn.close()
        if not promos:
            bot.answer_callback_query(call.id, "Нет промокодов")
            return
        markup = InlineKeyboardMarkup(row_width=2)
        for p in promos:
            markup.add(InlineKeyboardButton(f"❌ {p[1]}", callback_data=f"admin_del_promo_confirm_{p[0]}"))
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_promocodes"))
        bot.edit_message_text("🗑 Выберите:", user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data.startswith("admin_del_promo_confirm_"):
        promo_id = int(data.split("_")[4])
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("DELETE FROM promocodes WHERE id=?", (promo_id,))
        conn.commit()
        conn.close()
        bot.answer_callback_query(call.id, "✅ Удалён")
        edit_to_main_menu(user_id, call.message.message_id)

    elif data == "admin_list_promo":
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("SELECT code, discount_type, discount_value, uses FROM promocodes")
        promos = c.fetchall()
        conn.close()
        text = "🎫 <b>Промокоды</b>\n\n" if promos else "Нет промокодов"
        for p in promos:
            text += f"📌 {p[0]} | {p[1]} | {p[2]} | Исп: {p[3]}\n"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(InlineKeyboardButton("🔙 Назад", callback_data="admin_promocodes"))
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    # ===== УПРАВЛЕНИЕ ПОДДЕРЖКОЙ =====
    elif data == "admin_support":
        support_username = get_setting('support_username', '')
        support_text = get_setting('support_text', '')
        text = (f"🆘 <b>Управление поддержкой</b>\n\n"
                f"👤 Текущий юзернейм: @{support_username}\n"
                f"📝 Текущий текст: {support_text}")
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(
            InlineKeyboardButton("✏️ Изменить юзернейм", callback_data="admin_support_username"),
            InlineKeyboardButton("📝 Изменить текст", callback_data="admin_support_text"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_support_username":
        bot.edit_message_text("👤 Введите юзернейм поддержки (без @):", user_id, call.message.message_id,
                              parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_support_username)

    elif data == "admin_support_text":
        bot.edit_message_text("📝 Введите текст для раздела «Поддержка»:", user_id, call.message.message_id,
                              parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_support_text)

    # ===== УПРАВЛЕНИЕ ИНФО =====
    elif data == "admin_info":
        info_text = get_setting('info_text', '')
        text = f"ℹ️ <b>Управление Инфо</b>\n\nТекущий текст:\n\n{info_text}"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(
            InlineKeyboardButton("✏️ Изменить текст", callback_data="admin_info_edit"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_info_edit":
        bot.edit_message_text("ℹ️ Введите новый текст для команды /info:", user_id, call.message.message_id,
                              parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_info_text)

    # ===== УПРАВЛЕНИЕ БАННЕРОМ =====
    elif data == "admin_banner":
        banner_photo = get_setting('banner_photo', '')
        banner_caption = get_setting('banner_caption', '')
        text = (f"🖼 <b>Управление баннером</b>\n\n"
                f"📷 Фото: {'✅ установлено' if banner_photo else '❌ не установлено'}\n"
                f"📝 Подпись: {banner_caption if banner_caption else '❌ нет'}\n\n"
                f"Баннер показывается в главном меню (/start).")
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(
            InlineKeyboardButton("📷 Установить фото", callback_data="admin_banner_photo"),
            InlineKeyboardButton("📝 Установить подпись", callback_data="admin_banner_caption"),
            InlineKeyboardButton("🗑 Удалить баннер", callback_data="admin_banner_delete"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(text, user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_banner_photo":
        bot.edit_message_text("📷 Отправьте фото для баннера:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_banner_photo)

    elif data == "admin_banner_caption":
        bot.edit_message_text("📝 Введите подпись под баннером (или /skip чтобы не менять):",
                              user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_banner_caption)

    elif data == "admin_banner_delete":
        set_setting('banner_photo', '')
        set_setting('banner_caption', '')
        bot.answer_callback_query(call.id, "✅ Баннер удалён")
        handle_admin_actions(call)

    # ===== УВЕДОМЛЕНИЯ =====
    elif data == "admin_notify":
        current = get_setting('notify_enabled', '1')
        status = "🔔 Вкл" if current == '1' else "🔕 Выкл"
        markup = InlineKeyboardMarkup(row_width=1)
        markup.add(
            InlineKeyboardButton("🔀 Переключить", callback_data="admin_toggle_notify"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(f"<b>Уведомления</b>\n\nСтатус: {status}", user_id, call.message.message_id,
                              reply_markup=markup, parse_mode="HTML")

    elif data == "admin_toggle_notify":
        current = get_setting('notify_enabled', '1')
        set_setting('notify_enabled', '0' if current == '1' else '1')
        bot.answer_callback_query(call.id, "Переключено")
        handle_admin_actions(call)

    # ===== РАССЫЛКА =====
    elif data == "admin_mailing":
        bot.edit_message_text("📨 Введите текст рассылки:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_mailing)

    # ===== ПРИВЕТСТВИЕ =====
    elif data == "admin_welcome":
        bot.edit_message_text("💬 Введите новое приветствие:", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_welcome_change)

    # ===== БОНУСЫ =====
    elif data == "admin_bonus":
        current = get_setting('bonus_enabled', '1')
        percent = get_setting('bonus_percent', '10')
        status = "✅ Вкл" if current == '1' else "❌ Выкл"
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("🔀 Переключить", callback_data="admin_toggle_bonus"),
            InlineKeyboardButton("✏️ Изменить %", callback_data="admin_edit_bonus"),
            InlineKeyboardButton("🔙 Назад", callback_data="admin")
        )
        bot.edit_message_text(f"🎁 <b>Бонусы</b>\n\nСтатус: {status}\nРазмер: {percent}%",
                              user_id, call.message.message_id, reply_markup=markup, parse_mode="HTML")

    elif data == "admin_toggle_bonus":
        current = get_setting('bonus_enabled', '1')
        set_setting('bonus_enabled', '0' if current == '1' else '1')
        bot.answer_callback_query(call.id, "Переключено")
        handle_admin_actions(call)

    elif data == "admin_edit_bonus":
        bot.edit_message_text("Введите % (1-100):", user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_bonus_change)

    # ===== ПРЕФИКС =====
    elif data == "admin_order_prefix":
        current = get_setting('order_prefix', 'SHOP')
        bot.edit_message_text(f"🔢 Текущий префикс: {current}\n\nВведите новый:",
                              user_id, call.message.message_id, parse_mode="HTML")
        bot.register_next_step_handler(call.message, process_order_prefix_change)

    else:
        bot.answer_callback_query(call.id, "⚠️ Функция в разработке")


# ===== ОБРАБОТЧИКИ ШАГОВ =====
def process_search_order(message):
    user_id = message.from_user.id
    order = get_order_by_num(message.text.strip().upper())
    if order:
        show_order_info(user_id, order)
    else:
        bot.send_message(user_id, "❌ Заказ не найден", reply_markup=main_menu(user_id))


def process_add_order_data(message, order_num):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("UPDATE orders SET delivery_data=? WHERE order_num=?", (message.text, order_num))
    conn.commit()
    conn.close()
    bot.send_message(user_id, "✅ Данные добавлены", reply_markup=main_menu(user_id))
    order = get_order_by_num(order_num)
    if order:
        try:
            bot.send_message(order[2], f"📦 К заказу {order_num} добавлены данные:\n\n{message.text}")
        except:
            pass


def process_check_balance(message):
    user_id = message.from_user.id
    try:
        target_id = int(message.text.strip())
        bot.send_message(user_id, f"💰 Баланс {target_id}: {get_balance(target_id)}₽", reply_markup=main_menu(user_id))
    except:
        bot.send_message(user_id, "❌ Введите ID", reply_markup=main_menu(user_id))


def process_order_prefix_change(message):
    user_id = message.from_user.id
    prefix = message.text.strip().upper()
    if not prefix or not prefix.isalnum():
        bot.send_message(user_id, "❌ Только буквы и цифры", reply_markup=main_menu(user_id))
        return
    set_setting('order_prefix', prefix)
    bot.send_message(user_id, f"✅ Префикс: {prefix}", reply_markup=main_menu(user_id))


def process_mailing(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("SELECT id FROM users")
    users = c.fetchall()
    conn.close()
    sent = 0
    for u in users:
        try:
            bot.send_message(u[0], message.text, parse_mode="HTML")
            sent += 1
            time.sleep(0.05)
        except:
            pass
    bot.send_message(user_id, f"📨 Отправлено {sent}", reply_markup=main_menu(user_id))


def process_welcome_change(message):
    user_id = message.from_user.id
    set_setting('welcome_msg', message.text)
    bot.send_message(user_id, "✅ Обновлено!", reply_markup=main_menu(user_id))


def process_bonus_change(message):
    user_id = message.from_user.id
    try:
        percent = int(message.text)
        if percent < 1 or percent > 100:
            raise ValueError
        set_setting('bonus_percent', str(percent))
        bot.send_message(user_id, f"✅ Бонус: {percent}%", reply_markup=main_menu(user_id))
    except:
        bot.send_message(user_id, "❌ 1-100", reply_markup=main_menu(user_id))


def process_admin_add_balance(message):
    user_id = message.from_user.id
    try:
        parts = message.text.split()
        target_user = int(parts[0])
        amount = float(parts[1])
        add_balance(target_user, amount)
        bot.send_message(user_id, f"✅ +{amount}₽", reply_markup=main_menu(user_id))
        try:
            bot.send_message(target_user, f"💰 +{amount}₽")
        except:
            pass
    except:
        bot.send_message(user_id, "❌ Формат: ID сумма", reply_markup=main_menu(user_id))


def process_admin_sub_balance(message):
    user_id = message.from_user.id
    try:
        parts = message.text.split()
        target_user = int(parts[0])
        amount = float(parts[1])
        add_balance(target_user, -amount)
        bot.send_message(user_id, f"✅ -{amount}₽", reply_markup=main_menu(user_id))
    except:
        bot.send_message(user_id, "❌ Формат: ID сумма", reply_markup=main_menu(user_id))


def process_create_promo(message):
    user_id = message.from_user.id
    try:
        parts = message.text.split('|')
        code = parts[0].strip().upper()
        disc_type = parts[1].strip()
        disc_value = float(parts[2].strip())
        conn = sqlite3.connect('shop.db')
        c = conn.cursor()
        c.execute("INSERT INTO promocodes (code, discount_type, discount_value, created_at) VALUES (?, ?, ?, ?)",
                  (code, disc_type, disc_value, datetime.now().isoformat()))
        conn.commit()
        conn.close()
        bot.send_message(user_id, f"✅ Промокод '{code}' создан!", reply_markup=main_menu(user_id))
    except:
        bot.send_message(user_id, "❌ Формат: код|тип|значение", reply_markup=main_menu(user_id))


def process_support_username(message):
    user_id = message.from_user.id
    username = message.text.strip().lstrip('@')
    set_setting('support_username', username)
    bot.send_message(user_id, f"✅ Юзернейм поддержки: @{username}", reply_markup=main_menu(user_id))


def process_support_text(message):
    user_id = message.from_user.id
    set_setting('support_text', message.text)
    bot.send_message(user_id, "✅ Текст поддержки обновлён!", reply_markup=main_menu(user_id))


def process_info_text(message):
    user_id = message.from_user.id
    set_setting('info_text', message.text)
    bot.send_message(user_id, "✅ Инфо обновлено!", reply_markup=main_menu(user_id))


def process_banner_photo(message):
    user_id = message.from_user.id
    if not message.photo:
        bot.send_message(user_id, "❌ Отправьте фото", reply_markup=main_menu(user_id))
        return
    file_id = message.photo[-1].file_id
    set_setting('banner_photo', file_id)
    bot.send_message(user_id, "✅ Баннер установлен! Проверьте /start", reply_markup=main_menu(user_id))


def process_banner_caption(message):
    user_id = message.from_user.id
    if message.text == "/skip":
        bot.send_message(user_id, "Пропущено", reply_markup=main_menu(user_id))
        return
    set_setting('banner_caption', message.text)
    bot.send_message(user_id, "✅ Подпись баннера обновлена!", reply_markup=main_menu(user_id))


# ===== ДОБАВЛЕНИЕ ТОВАРА =====
def process_add_product_name(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO temp_product_data VALUES (?, ?, ?)", (user_id, 'name', message.text))
    conn.commit()
    conn.close()
    bot.send_message(user_id, "📝 Описание:")
    bot.register_next_step_handler(message, process_add_product_desc)


def process_add_product_desc(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO temp_product_data VALUES (?, ?, ?)", (user_id, 'desc', message.text))
    conn.commit()
    conn.close()
    bot.send_message(user_id, "💰 Цена:")
    bot.register_next_step_handler(message, process_add_product_price)


def process_add_product_price(message):
    user_id = message.from_user.id
    try:
        price = float(message.text.replace(',', '.'))
    except:
        bot.send_message(user_id, "❌ Введите число")
        return
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO temp_product_data VALUES (?, ?, ?)", (user_id, 'price', str(price)))
    conn.commit()
    conn.close()
    categories = get_categories(0)
    if not categories:
        bot.send_message(user_id, "❌ Сначала создайте категорию", reply_markup=main_menu(user_id))
        return
    markup = InlineKeyboardMarkup(row_width=2)
    for cat in categories:
        markup.add(InlineKeyboardButton(cat[1], callback_data=f"prod_cat_{cat[0]}"))
    markup.add(InlineKeyboardButton("🔙 Отмена", callback_data="admin_products"))
    bot.send_message(user_id, "📂 Выберите категорию:", reply_markup=markup)


def ask_delivery_type(user_id, msg):
    try:
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("✅ Авто", callback_data="prod_auto_yes"),
            InlineKeyboardButton("👤 Ручная", callback_data="prod_auto_no")
        )
        bot.edit_message_text("📦 Тип выдачи:", user_id, msg.message_id, reply_markup=markup)
    except Exception as e:
        print(f"❌ ask_delivery_type: {e}")


def process_delivery_data(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO temp_product_data VALUES (?, ?, ?)", (user_id, 'delivery_data', message.text))
    conn.commit()
    conn.close()
    ask_require_code(user_id, message)


def ask_require_code(user_id, msg):
    try:
        markup = InlineKeyboardMarkup(row_width=2)
        markup.add(
            InlineKeyboardButton("🔑 Да", callback_data="prod_code_yes"),
            InlineKeyboardButton("🚫 Нет", callback_data="prod_code_no")
        )
        if isinstance(msg, types.Message):
            bot.send_message(user_id, "🔐 Требуется код?", reply_markup=markup)
        else:
            bot.edit_message_text("🔐 Требуется код?", user_id, msg.message_id, reply_markup=markup)
    except Exception as e:
        print(f"❌ ask_require_code: {e}")


def process_code_data(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT OR REPLACE INTO temp_product_data VALUES (?, ?, ?)", (user_id, 'code_data', message.text))
    conn.commit()
    conn.close()
    save_product(user_id, message)


def save_product(user_id, msg):
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("SELECT step, data FROM temp_product_data WHERE user_id=?", (user_id,))
    data = {row[0]: row[1] for row in c.fetchall()}
    if all(k in data for k in ['name', 'desc', 'price', 'category', 'subcategory', 'auto']):
        c.execute("""INSERT INTO products 
                     (name, description, price, category_id, subcategory_id, auto_delivery, delivery_data, require_code, code_data)
                     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                  (data['name'], data['desc'], float(data['price']), int(data['category']),
                   int(data['subcategory']), int(data['auto']),
                   data.get('delivery_data', ''),
                   1 if 'code_data' in data else 0,
                   data.get('code_data', '')))
        c.execute("DELETE FROM temp_product_data WHERE user_id=?", (user_id,))
        conn.commit()
        conn.close()
        bot.send_message(user_id, "✅ Товар добавлен!", reply_markup=main_menu(user_id))
    else:
        conn.close()
        bot.send_message(user_id, "❌ Не все данные заполнены")


def process_add_category(message):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT INTO categories (name, level) VALUES (?, 0)", (message.text,))
    conn.commit()
    conn.close()
    bot.send_message(user_id, f"✅ Категория '{message.text}' добавлена!", reply_markup=main_menu(user_id))


def process_add_subcategory(message, parent_id):
    user_id = message.from_user.id
    conn = sqlite3.connect('shop.db')
    c = conn.cursor()
    c.execute("INSERT INTO categories (name, parent_id, level) VALUES (?, ?, 1)", (message.text, parent_id))
    conn.commit()
    conn.close()
    bot.send_message(user_id, f"✅ Подкатегория '{message.text}' добавлена!", reply_markup=main_menu(user_id))


# ===== PLATEGA =====
def create_platega_payment(amount, order_num, user_id, product_name):
    if not is_platega_enabled():
        return False, None, "Platega не настроена"
    try:
        payment_data = {
            "shop_id": PLATEGA_SHOP_ID,
            "amount": str(amount),
            "order_id": order_num,
            "currency": "RUB",
            "description": f"Заказ {order_num}",
            "success_url": f"https://t.me/{BOT_USERNAME.replace('@', '')}",
            "fail_url": f"https://t.me/{BOT_USERNAME.replace('@', '')}",
            "notification_url": PLATEGA_WEBHOOK_URL,
            "customer_id": str(user_id)
        }
        signature = hmac.new(PLATEGA_SECRET_KEY.encode('utf-8'),
                             json.dumps(payment_data).encode('utf-8'), hashlib.sha256).hexdigest()
        payment_data["signature"] = signature
        headers = {"Content-Type": "application/json", "X-API-Key": PLATEGA_API_KEY}
        response = requests.post(f"{PLATEGA_API_URL}/payment/create",
                                 json=payment_data, headers=headers, timeout=30)
        if response.status_code == 200:
            result = response.json()
            return True, result.get("payment_id"), result.get("payment_url")
        return False, None, f"Ошибка: {response.text}"
    except Exception as e:
        return False, None, f"Ошибка: {str(e)}"


def check_platega_payment(payment_id):
    if not is_platega_enabled():
        return False, "Platega не настроена"
    try:
        headers = {"X-API-Key": PLATEGA_API_KEY}
        response = requests.get(f"{PLATEGA_API_URL}/payment/status/{payment_id}",
                                headers=headers, timeout=30)
        if response.status_code == 200:
            result = response.json()
            status = result.get("status")
            if status == "completed":
                return True, "Оплата прошла"
            elif status == "pending":
                return False, "Ожидание"
            else:
                return False, f"Статус: {status}"
        return False, f"Ошибка: {response.text}"
    except Exception as e:
        return False, f"Ошибка: {str(e)}"


# ===== ЗАПУСК =====
