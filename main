    print("🤖 Бот запущен...")
    print(f"👥 Админы: {ADMIN_IDS}")
    print(f"💳 Platega: {'✅' if is_platega_enabled() else '❌ (только баланс)'}")
    while True:
        try:
            bot.polling(none_stop=True, timeout=60)
        except Exception as e:
            print(f"⚠️ Ошибка: {e}")
            print("🔄 Перезапуск через 5 сек...")
            time.sleep(5)
