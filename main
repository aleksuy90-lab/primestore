    print("🤖 Бот запущен...")
    print(f"👥 Админы: {ADMIN_IDS}")
    print("📋 Номера заказов имеют формат: PREFIX-YYMMDD-XXXXXX")
    print("💳 Работает только с балансом (без внешних платежей)")
    bot.polling(none_stop=True)
